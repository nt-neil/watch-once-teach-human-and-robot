{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyframe description table v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "frames"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_sha256", "video_name", "duration_ms", "provider", "mock", "frame_manifest"],
      "properties": {
        "video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "video_name": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 60000},
        "provider": {"type": "string", "enum": ["mock", "meta"]},
        "mock": {"type": "boolean"},
        "frame_manifest": {"type": "string", "enum": ["frames.json"]}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kf_id", "t_s", "text_seen", "state"],
        "properties": {
          "kf_id": {"type": "string"},
          "t_s": {"type": "number", "minimum": 0},
          "text_seen": {"type": "array", "items": {"type": "string"}},
          "state": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
