{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "VLA instruction sequence",
 "type": "object", "additionalProperties": false,
 "required": ["format", "episode_id", "source_video_sha256", "steps"],
 "properties": {
  "format": {"const": "vla-instruction-sequence/0.1"},
  "episode_id": {"type": "string", "minLength": 1},
  "source_video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "steps": {"type": "array", "minItems": 1, "items": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "instruction", "start_s", "end_s"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "start_s": {"type": "number", "minimum": 0},
    "end_s": {"type": "number", "exclusiveMinimum": 0}}}}}}
