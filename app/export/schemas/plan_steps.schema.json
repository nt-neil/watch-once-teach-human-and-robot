{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Behavior-tree / PDDL-style plan steps",
 "type": "object", "additionalProperties": false,
 "required": ["format", "episode_id", "source_video_sha256", "note", "steps"],
 "properties": {
  "format": {"const": "bt-pddl-plan-steps/0.1"},
  "episode_id": {"type": "string", "minLength": 1},
  "source_video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "note": {"type": "string", "minLength": 1},
  "steps": {"type": "array", "minItems": 1, "items": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "action", "instruction", "target", "preconditions", "effects", "start_s", "end_s"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "action": {"enum": ["pick", "place", "insert", "press", "rotate", "push", "pull", "open", "close", "click", "type", "other"]},
    "instruction": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "start_s": {"type": "number", "minimum": 0},
    "end_s": {"type": "number", "exclusiveMinimum": 0}}}}}}
