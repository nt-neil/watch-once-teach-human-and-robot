{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "LeRobot v3 episode annotation layer (no robot data)",
 "type": "object", "additionalProperties": false,
 "required": ["format", "annotation_only", "robot_state_action_data", "episode", "not_included", "reference"],
 "properties": {
  "format": {"const": "lerobot-v3-episode-annotation/0.1"},
  "annotation_only": {"const": true},
  "robot_state_action_data": {"type": "null"},
  "episode": {"type": "object", "additionalProperties": false,
   "required": ["episode_id", "task", "task_id", "source_video_sha256", "source_video_name", "duration_s", "subtasks"],
   "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "task_id": {"type": "integer", "minimum": 0},
    "source_video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_video_name": {"type": "string", "minLength": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "subtasks": {"type": "array", "minItems": 1, "items": {
     "type": "object", "additionalProperties": false,
     "required": ["subtask_id", "step_id", "instruction", "instruction_origin", "action_primitive", "primitive_origin",
      "object", "action", "target", "pre", "done", "start_s", "end_s", "source_frames"],
     "properties": {
      "subtask_id": {"type": "string", "minLength": 1},
      "step_id": {"type": "string", "minLength": 1},
      "instruction": {"type": "string", "minLength": 1},
      "instruction_origin": {"type": "string", "minLength": 1},
      "action_primitive": {"enum": ["pick", "place", "insert", "press", "rotate", "push", "pull", "open", "close", "click", "type", "other"]},
      "primitive_origin": {"type": "string", "minLength": 1},
      "object": {"type": "string", "minLength": 1},
      "action": {"type": "string", "minLength": 1},
      "target": {"type": "string", "minLength": 1},
      "pre": {"type": "string", "minLength": 1},
      "done": {"type": "string", "minLength": 1},
      "start_s": {"type": "number", "minimum": 0},
      "end_s": {"type": "number", "exclusiveMinimum": 0},
      "source_frames": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}}},
  "not_included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "reference": {"type": "string", "minLength": 1}}}
