# Local Meta API key for paid inference (copy to .env and fill in).
# .env is gitignored — never commit the real key.
META_API_KEY=

# Daily paid caps (optional). Open-source defaults: 20 calls / US$1.00 per day.
# Uncomment to override; the server enforces these for web and MCP.
#WEB_MAX_CALLS_PER_DAY=20
#WEB_MAX_USD_PER_DAY=1.00
